g: 2px 6px;vertical-align: middle;margin-left: 6px}\n    .price-main {font-size: 24px;font-weight: 900;color: var(--orange)}\n    .price-sub {font-size: 13px;color: #666666;margin-top: 4px}\n    ul.feature-list {list-style: none;padding-left: 0}\n    ul.feature-list li {margin-bottom: 8px;font-size: 14px;display: flex;align-items: baseline;gap: 6px}\n    ul.feature-list li::before {content: \"▪\";color: var(--orange)}\n    .faq-columns {display: grid;grid-template-columns: 1fr 1fr;gap: 32px}\n    .faq-item {border: var(--border-thick);padding: 24px;background: #ffffff}\n    .faq-item h3 {font-size: 18px;font-weight: 800;margin-bottom: 12px;color: #111111;display: flex;align-items: flex-start;gap: 8px}\n    .faq-item h3 span {background: var(--orange);color: #ffffff;font-size: 12px;padding: 1px 6px;line-height: 1.4;flex-shrink: 0;margin-top: 2px}\n    .faq-item p {font-size: 15px;color: #444444;line-height: 1.6}\n    footer.site-foot {padding: 40px 48px;background: #111111;color: #ffffff;display: flex;justify-content: space-between;align-items: center;flex-wrap: wrap;gap: 20px}\n    footer.site-foot p {font-size: 13px;color: #aaaaaa}\n    @media (max-width: 900px) {\n      body {flex-direction: column}\n      nav.side-nav {width: 100%;height: auto;position: static;border-right: none;border-bottom: var(--border-thick);padding: 20px 24px}\n      nav.side-nav ul {flex-direction: row;flex-wrap: wrap;gap: 12px 18px;margin: 16px 0}\n      .poster-hero {padding: 40px 24px 32px}\n      section.content-block {padding: 40px 24px}\n      .faq-columns {grid-template-columns: 1fr;gap: 20px}\n      footer.site-foot {padding: 30px 24px}\n    }\n  </style><nav class=\"side-nav\">\n    <div>\n      <a href=\"#\" class=\"nav-brand\">极影加速</a>\n      <ul>\n        <li><a class=\"nav-link\" href=\"#hero\">品牌速写</a></li>\n        <li><a class=\"nav-link\" href=\"#guide\">上手步骤</a></li>\n        <li><a class=\"nav-link\" href=\"#plans\">对比方案</a></li>\n        <li><a class=\"nav-link\" href=\"#clients\">软件建议</a></li>\n        <li><a class=\"nav-link\" href=\"#faq\">答疑解惑</a></li>\n      </ul>\n    </div>\n    <div class=\"nav-foot\">\n      简单分流 · 随手查阅<br>\n      极影加速设计备忘\n    </div>\n  </nav>\n\n  <main>\n    <header class=\"poster-hero\" id=\"hero\">\n      <span class=\"poster-tag\">NOTEBOOK &amp; SPECS</span>\n      <h1>极影加速</h1>\n      <p class=\"intro-lead\">\n        嗨，欢迎来看看！这里是极影加速的内容板。平时我们自己在不同网络环境里折腾配置，常常碰到规则写错或者参数对不齐的烦恼，所以干脆把各规格特点、常用平台的接入流程和常见的小疑问全整理在这儿，希望也能帮到正在寻找合适方案的你。\n      </p>\n    </header>\n\n    <section class=\"content-block\" id=\"guide\">\n      <div class=\"block-header\">\n        <h2>从零开始接入</h2>\n        <p>不用把网络调试想得太复杂，跟着这三步走，几分钟就能跑通。</p>\n      </div>\n      <div class=\"card-grid\">\n        <article class=\"stark-card\">\n          <h3><span class=\"card-index\">01</span> 获取订阅链接</h3>\n          <p>进入你的个人中心，找到格式匹配的订阅文本。建议优先选择支持自动更新的通用格式，方便后续规则同步。</p>\n          <a class=\"action-link\" href=\"#plans\">查看备选方案规格 →</a>\n        </article>\n        <article class=\"stark-card\">\n          <h3><span class=\"card-index\">02</span> 导入客户端</h3>\n          <p>在你的日常设备上打开网络工具，新建配置并粘贴订阅地址。点击更新配置，等待几秒拉取完整的节点名录。</p>\n          <a class=\"action-link\" href=\"#clients\">支持的软件工具说明 →</a>\n        </article>\n        <article class=\"stark-card\">\n          <h3><span class=\"card-index\">03</span> 开启规则分流</h3>\n          <p>日常建议切换到“规则分流”或“绕过大陆”模式，这样本地日常访问不会绕路，只在需要查询海外资料时自动接入中转。</p>\n          <a class=\"action-link\" href=\"#faq\">分流疑问排查 →</a>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"content-block\" id=\"plans\">\n      <div class=\"block-header\">\n        <h2>方案对比对照表</h2>\n        <p>我们把目前几套常见档位横向铺开，每一档适合的使用强度一目了然。</p>\n      </div>\n\n      <div class=\"table-container\">\n        <table class=\"plans-table\">\n          <thead>\n            <tr>\n              <th>对照项目</th>\n              <th>基础版</th>\n              <th class=\"highlight-col\">旗舰版 <span class=\"badge-pop\">推荐</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付单价</th>\n              <td><span class=\"price-main\">¥15</span> /月</td>\n              <td class=\"highlight-col\"><span class=\"price-main\">¥35</span> /月</td>\n              <td><span class=\"price-main\">¥85</span> /月</td>\n            </tr>\n            <tr>\n              <th>按年优惠</th>\n              <td><div class=\"price-sub\">按年付仅需 ¥150/年</div></td>\n              <td class=\"highlight-col\"><div class=\"price-sub\">按年付仅需 ¥350/年</div></td>\n              <td><div class=\"price-sub\">按年付仅需 ¥850/年</div></td>\n            </tr>\n            <tr>\n              <th>可用流量</th>\n              <td>每月 100GB 极速流量</td>\n              <td class=\"highlight-col\">每月 300GB 极速流量</td>\n              <td>每月 1000GB 极速流量</td>\n            </tr>\n            <tr>\n              <th>并发设备上限</th>\n              <td>3 台设备同时在线</td>\n              <td class=\"highlight-col\">5 台设备同时在线</td>\n              <td>20 台设备同时在线</td>\n            </tr>\n            <tr>\n              <th>路由与线路特性</th>\n              <td>普通线路节点池</td>\n              <td class=\"highlight-col\">IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点，支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>解锁支持</th>\n              <td>解锁基础流媒体</td>\n              <td class=\"highlight-col\">全节点原生流媒体解锁</td>\n              <td>支持企业定制流媒体策略与全节点覆盖</td>\n            </tr>\n            <tr>\n              <th>支持服务</th>\n              <td>常规工单支持</td>\n              <td class=\"highlight-col\">7x24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合场景</th>\n              <td>轻量浏览网页、查阅邮件与偶看视频</td>\n              <td class=\"highlight-col\">主力机全天候挂载、影音流媒体与跨区联机</td>\n              <td>工作室小组、多设备测试及高频带宽需求</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"content-block\" id=\"clients\">\n      <div class=\"block-header\">\n        <h2>客户端应用建议</h2>\n        <p>极影加速遵循标准开放协议，你可以使用任何你习惯的核心与工具接入，无需绑定专属外壳。</p>\n      </div>\n\n      <div class=\"card-grid\">\n        <article class=\"stark-card\">\n          <h3>Windows / macOS 桌面端</h3>\n          <p>\n            桌面办公环境建议采用支持规则分流的内核客户端（例如 Clash Verge、Sing-box 桌面版）。它们能方便地依据域名和 IP 段自动判断国内直连与海外走中继，不会干扰日常局域网和国内办公软件。\n          </p>\n          <a class=\"action-link\" href=\"#\">查看配置文档索引 →</a>\n        </article>\n\n        <article class=\"stark-card\">\n          <h3>iOS / iPadOS 移动端</h3>\n          <p>\n            在苹果生态中，Shadowrocket、Loon 或 Quantumult X 都是经受住时间检验的实用工具。直接将极影加速的通用订阅 URL 导入软件，勾选自动后台更新，平时外出切 Wi-Fi 与蜂窝网络都能无感衔接。\n          </p>\n          <a class=\"action-link\" href=\"#\">了解 iOS 配置方式 →</a>\n        </article>\n\n        <article class=\"stark-card\">\n          <h3>Android 平台</h3>\n          <p>\n            开源社区有非常丰富的图形化客户端（如 Clash Meta for Android、v2rayNG 等）。建议在设置中开启“允许应用绕过”功能，把国内网银和常用聊天工具设为直连，省电也更踏实。\n          </p>\n          <a class=\"action-link\" href=\"#\">安卓导入贴士 →</a>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"content-block\" id=\"faq\">\n      <div class=\"block-header\">\n        <h2>常见问答随手查</h2>\n        <p>大家平时问得最多的几个小问题，这里做个详细的集中交代。</p>\n      </div>\n\n      <div class=\"faq-columns\">\n        <div class=\"faq-item\">\n          <h3><span>Q</span> 套餐里的同时在线设备数怎么计算？</h3>\n          <p>\n            这个限制指的是同一时刻处于连接状态的物理终端数。比如你选了旗舰版的 5 台，你在家里电脑、平板、手机和备用机同时开着都没问题。如果外出临时多连了一台，可能会导致最先连接的设备出现握手中断，断开闲置设备即可恢复。\n          </p>\n        </div>\n\n        <div class=\"faq-item\">\n          <h3><span>Q</span> 订阅更新失败或者无法拉取节点怎么处理？</h3>\n          <p>\n            多半是因为本地客户端在拉取订阅时尝试走未建立的代理。可以先检查一下软件里的“更新订阅时绕过代理”选项是否勾选。另外也可以直接把订阅链接粘贴到普通浏览器地址栏试一下，看看文本内容能否正常读取。\n          </p>\n        </div>\n\n        <div class=\"faq-item\">\n          <h3><span>Q</span> 游戏联机和看海外剧应该选哪种节点？</h3>\n          <p>\n            如果你的套餐包含 IPLC 优化线路，玩游戏时尽量选择延迟数值平稳的就近专线节点，避开拥挤的主干道。如果是看剧，留意节点列表中标注了流媒体支持的标签，系统会自动指派具有原生 IP 广播的中转出口。\n          </p>\n        </div>\n\n        <div class=\"faq-item\">\n          <h3><span>Q</span> 每个月的流量是按自然月重置吗？</h3>\n          <p>\n            流量计数周期是根据你购买订阅的那一天开始计算的，并非统一在每月 1 号重置。你可以在面板上清楚看到当前计费周期的起止日期与剩余额度，避免月尾突发用尽。\n          </p>\n        </div>\n      </div>\n    </section>\n\n    <footer class=\"site-foot\">\n      <div>\n        <strong>极影加速</strong> — 朴实好用的网络中继日常对照手册\n      </div>\n      <p>© 极影加速 开放信息展示 · 请合理规范使用网络资源</p>\n    </footer>\n  </main>",
